# Copy this file to .env and fill in your keys.
# NOT needed for paper trading or backtesting.

# Crypto exchange (ccxt) — e.g. Binance, Coinbase, Kraken
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Alpaca (stocks) — get keys at https://alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Trade alerts (optional)
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs: private chat + groups (e.g. 123456789,-100123456789)
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
